# Copie este arquivo para .env.local e preencha com os valores reais.
# .env.local nunca é commitado (veja .gitignore) e essas chaves nunca
# aparecem no código do front-end.

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# supabase.com -> Project Settings -> API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# resend.com -> API Keys
RESEND_API_KEY=
# Endereço que recebe o briefing privado diário. Enquanto o domínio de envio
# não for verificado em resend.com/domains, só pode ser o e-mail usado pra
# criar a conta Resend (limitação do domínio de teste onboarding@resend.dev).
BRIEFING_EMAIL_TO=rogerrhoden1@gmail.com

# brapi.dev -> Meu Perfil -> token gratuito (necessário só para PRIO3)
BRAPI_TOKEN=

# alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Senha simples e compartilhada para o time acessar o dashboard
DASHBOARD_PASSWORD=

# Gerado automaticamente pela Vercel ao criar um Cron Job — protege a rota
# da rotina diária contra chamadas externas não autorizadas
CRON_SECRET=
